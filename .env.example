# Copy to .env and fill in ONE provider key to start.
# .env is gitignored. Never commit real keys.

# Which provider/adapter to use (overrides config.yaml)
LLM_PROVIDER=groq
# Exact model id; must exist for the provider above. Verify with:
#   python scripts/smoke_llm.py --models
LLM_MODEL=qwen/qwen3.8-27b

# Optional app mode override: facts_only | debug
# APP_MODE=debug

# --- API keys (only the selected provider is required) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
